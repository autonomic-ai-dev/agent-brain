{
  "version": 1,
  "utilities": {
    "tekmor": {
      "alias": "brain",
      "description": "Turn routing, memory, and skills for AI coding agents",
      "invoke": [
        "tekmor route_task",
        "tekmor registry list",
        "tekmor add @alias",
        "tekmor doctor"
      ],
      "mcp_tools": ["route_task", "store_memory", "skill_search", "skill_get"]
    },
    "thesmos": {
      "alias": "spine",
      "description": "Deterministic YAML workflow DAG execution",
      "invoke": ["thesmos run --workflow <name>", "thesmos init"],
      "when": "Multi-step repeatable tasks with approval gates (release notes, stacked PRs, bugfix loops)"
    }
  }
}
