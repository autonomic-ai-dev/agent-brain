{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/tekmor/route_gate_run.sh",
        "matcher": "UserPromptSubmit"
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/tekmor/route_gate_run.sh"
      }
    ],
    "postToolUse": [
      {
        "command": "./hooks/tekmor/route_gate_run.sh"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./hooks/tekmor/route_gate_run.sh",
        "failClosed": true
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./hooks/tekmor/route_gate_run.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./hooks/tekmor/route_gate_run.sh",
        "failClosed": true
      }
    ]
  }
}
