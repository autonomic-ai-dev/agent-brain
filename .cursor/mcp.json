{
  "mcpServers": {
    "tekmor": {
      "args": [
        "serve"
      ],
      "command": "/opt/homebrew/bin/tekmor",
      "env": {
        "TEKMOR_AUTO_UPDATE_DELAY_SEC": "60",
        "TEKMOR_BOOTSTRAP_BG": "1",
        "TEKMOR_BOOTSTRAP_DELAY_SEC": "2",
        "TEKMOR_BOOTSTRAP_INTERVAL_SEC": "3600",
        "TEKMOR_SESSION_INGEST_DELAY_SEC": "180",
        "RUST_LOG": "tekmor=info"
      }
    }
  }
}
